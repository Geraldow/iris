    {
      "id": "s3_content",
      "type": "text",
      "x": 860,
      "y": 586,
      "width": 720,
      "height": 336,
      "angle": 0,
      "strokeColor": "#164e63",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 213,
      "version": 2,
      "versionNonce": 1553119642,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1780589873454,
      "link": null,
      "locked": false,
      "text": "1  User/CC  →  iris_task(prompt, effort, adapter?)\n2  iris     →  AdapterManager.route(effort) → select adapter\n3  iris     →  CircuitBreaker.check(adapter) → ok | fallback\n4  iris     →  Adapter.execute(prompt, model, effort)\n5  Adapter  →  execa() spawn CLI process\n6  CLI      →  stdout: text | JSON | JSONL\n7  Adapter  →  parse output:\n               claude   → JSON → result.result\n               copilot  → text + strip stats block\n               opencode │ kilo → JSONL → type=text → part.text\n               agy      → stdout directo\n               cursor   → stdout directo\n8  iris     →  TaskStore.save(taskId, adapter, result)\n9  iris     →  Engram.log(topic, content)  [async]\n10 iris     →  return { result, taskId, adapter, effort, duration }\n──────────────────────────────────────────────────────────────────\nStreaming: opencode + kilo → JSONL en tiempo real\nTimeout: configurable por adapter (default 60s, agy 15min)\nRetry: circuit breaker activa fallback automático",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "1  User/CC  →  iris_task(prompt, effort, adapter?)\n2  iris     →  AdapterManager.route(effort) → select adapter\n3  iris     →  CircuitBreaker.check(adapter) → ok | fallback\n4  iris     →  Adapter.execute(prompt, model, effort)\n5  Adapter  →  execa() spawn CLI process\n6  CLI      →  stdout: text | JSON | JSONL\n7  Adapter  →  parse output:\n               claude   → JSON → result.result\n               copilot  → text + strip stats block\n               opencode │ kilo → JSONL → type=text → part.text\n               agy      → stdout directo\n               cursor   → stdout directo\n8  iris     →  TaskStore.save(taskId, adapter, result)\n9  iris     →  Engram.log(topic, content)  [async]\n10 iris     →  return { result, taskId, adapter, effort, duration }\n──────────────────────────────────────────────────────────────────\nStreaming: opencode + kilo → JSONL en tiempo real\nTimeout: configurable por adapter (default 60s, agy 15min)\nRetry: circuit breaker activa fallback automático",
      "index": "ah",
      "frameId": null,
      "autoResize": true,
      "lineHeight": 1.3603238866396763
    },

    {"id":"cb_text","type":"text","x":1110,"y":1035,"width":220,"height":70,"text":"⚡ Circuit Breaker\n\n3 failures consecutivos →\nOPEN por 5 min\nHalf-Open → 1 test request\n\nSi OPEN: fallback provider","originalText":"⚡ Circuit Breaker\n\n3 failures consecutivos →\nOPEN por 5 min\nHalf-Open → 1 test request\n\nSi OPEN: fallback provider","fontSize":10,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":105012,"version":1,"versionNonce":105013,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"circuit_breaker_box","lineHeight":1.25},


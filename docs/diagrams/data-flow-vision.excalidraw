    {"id":"flow_help_text","type":"text","x":1450,"y":1980,"width":350,"height":80,"text":"📐 Flujo completo del dato:\n\nDeveloper Prompt → MCP Server →\nClassifier → Selector → Gate →\nExecute (Subprocess/Terminal) →\nEngram Sync → SQLite → Diagrams →\nDocs → Teaching → Result → Developer","originalText":"📐 Flujo completo del dato:\n\nDeveloper Prompt → MCP Server →\nClassifier → Selector → Gate →\nExecute (Subprocess/Terminal) →\nEngram Sync → SQLite → Diagrams →\nDocs → Teaching → Result → Developer","fontSize":10,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":108022,"version":1,"versionNonce":108023,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},


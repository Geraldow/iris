    {"id":"zone5_title","type":"text","x":60,"y":1008,"width":500,"height":20,"text":"🔴 ZONA 5: VALIDACIÓN Y GATE — Confirmación antes de ejecutar","originalText":"🔴 ZONA 5: VALIDACIÓN Y GATE — Confirmación antes de ejecutar","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#1e40af","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":105004,"version":1,"versionNonce":105005,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"zone5_bg","lineHeight":1.25},

    {"id":"two_phase_commit_box","type":"rectangle","x":730,"y":1030,"width":280,"height":140,"strokeColor":"#b45309","backgroundColor":"#fef3c7","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":105006,"version":1,"versionNonce":105007,"isDeleted":false,"groupIds":[],"boundElements":[{"id":"two_phase_text","type":"text"},{"id":"arrow_prompt_to_gate","type":"arrow"},{"id":"arrow_gate_to_execute","type":"arrow"}],"link":null,"locked":false,"roundness":{"type":3}},
    {"id":"two_phase_text","type":"text","x":740,"y":1035,"width":260,"height":130,"text":"🛑 Two-Phase Commit Gate\n\nSi threshold=\"high\" y\nscore=high (71-100):\n\n1. Genera confirm_token (UUID)\n2. Guarda plan en pendingTokens\n   (10 min TTL)\n3. Devuelve status:\n   \"pending_confirmation\"\n4. Developer confirma con\n   confirm_token\n\nSi no: pasa directo a ejecutar","originalText":"🛑 Two-Phase Commit Gate\n\nSi threshold=\"high\" y\nscore=high (71-100):\n\n1. Genera confirm_token (UUID)\n2. Guarda plan en pendingTokens\n   (10 min TTL)\n3. Devuelve status:\n   \"pending_confirmation\"\n4. Developer confirma con\n   confirm_token\n\nSi no: pasa directo a ejecutar","fontSize":10,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":105008,"version":1,"versionNonce":105009,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"two_phase_commit_box","lineHeight":1.25},


    {"id":"selector_text","type":"text","x":1120,"y":510,"width":200,"height":70,"text":"📡 selectProvider()\n\nSegún phase → provider primario\nSegún taskType Odoo → override\nFallo → fallback provider\n\nModelos por complejidad","originalText":"📡 selectProvider()\n\nSegún phase → provider primario\nSegún taskType Odoo → override\nFallo → fallback provider\n\nModelos por complejidad","fontSize":10,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":104008,"version":1,"versionNonce":104009,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"selector_box","lineHeight":1.25},

    {"id":"provider_phase_table","type":"text","x":1360,"y":505,"width":250,"height":100,"text":"📋 Mapeo Phase → Provider:\n\nExplore → antigravity (Gemini)\nPropose → claude (Sonnet)\nSpec → claude (Sonnet)\nDesign → antigravity (Gemini)\nTasks → claude (Sonnet)\nApply → claude (Sonnet)\nVerify → claude (Sonnet)\nArchive → opencode (DeepSeek)","originalText":"📋 Mapeo Phase → Provider:\n\nExplore → antigravity (Gemini)\nPropose → claude (Sonnet)\nSpec → claude (Sonnet)\nDesign → antigravity (Gemini)\nTasks → claude (Sonnet)\nApply → claude (Sonnet)\nVerify → claude (Sonnet)\nArchive → opencode (DeepSeek)","fontSize":10,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":104010,"version":1,"versionNonce":104011,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},


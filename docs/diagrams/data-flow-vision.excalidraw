    {"id":"legend_zone_text","type":"text","x":30,"y":2285,"width":160,"height":110,"text":"LEYENDA\n\n🟦 Zonas del sistema\n⬆️/⬇️ Flujo del dato\n🔲 Box = Componente\n💬 Texto = Explicación\n🟢🟡🟠🔴 Prioridad","originalText":"LEYENDA\n\n🟦 Zonas del sistema\n⬆️/⬇️ Flujo del dato\n🔲 Box = Componente\n💬 Texto = Explicación\n🟢🟡🟠🔴 Prioridad","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#64748b","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100009,"version":1,"versionNonce":100010,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"legend_zone","lineHeight":1.25}

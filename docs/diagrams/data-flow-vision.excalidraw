    {"id":"odoo_detect_text","type":"text","x":500,"y":510,"width":220,"height":70,"text":"🔍 detectTaskType(instruction)\n\n130+ keywords → 23 tipos Odoo\nEj: \"campo\" → odoo-orm\n\"xpath\" → odoo-view\n\"commit\" → odoo-commit","originalText":"🔍 detectTaskType(instruction)\n\n130+ keywords → 23 tipos Odoo\nEj: \"campo\" → odoo-orm\n\"xpath\" → odoo-view\n\"commit\" → odoo-commit","fontSize":10,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":103010,"version":1,"versionNonce":103011,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"odoo_detect_box","lineHeight":1.25},


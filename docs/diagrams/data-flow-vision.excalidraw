    {"id":"budget_text","type":"text","x":1110,"y":1100,"width":220,"height":65,"text":"💰 Budget Tracker\n\n· Claude: $5/día\n· Codex: $2/día\n· Otros: $0 (gratis)\n· Reset diario a medianoche\n· Si over_budget → fallback","originalText":"💰 Budget Tracker\n\n· Claude: $5/día\n· Codex: $2/día\n· Otros: $0 (gratis)\n· Reset diario a medianoche\n· Si over_budget → fallback","fontSize":10,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#374151","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":105016,"version":1,"versionNonce":105017,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":"budget_box","lineHeight":1.25},


    { "type": "text", "id": "desc_uc1", "x": 490, "y": 105, "width": 360, "height": 55,
      "text": "Delegate prompt to best adapter by effort.\nAdapter auto-selected: LOW→kilo/cursor/opencode\nMED→copilot/agy  HIGH→claude/agy  THINKING→agy",
      "originalText": "Delegate prompt to best adapter by effort.\nAdapter auto-selected: LOW→kilo/cursor/opencode\nMED→copilot/agy  HIGH→claude/agy  THINKING→agy",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100,
      "angle": 0, "seed": 300, "version": 1, "versionNonce": 300,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null,
      "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "desc_uc2", "x": 490, "y": 182, "width": 360, "height": 40,
      "text": "Explicit adapter override. iris_delegate passes task\ndirectly to named adapter, bypassing routing.",
      "originalText": "Explicit adapter override. iris_delegate passes task\ndirectly to named adapter, bypassing routing.",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100,
      "angle": 0, "seed": 301, "version": 1, "versionNonce": 301,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null,
      "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "desc_uc3", "x": 490, "y": 257, "width": 360, "height": 40,
      "text": "View session task history: taskId, adapter used,\nresult summary, duration for each past call.",
      "originalText": "View session task history: taskId, adapter used,\nresult summary, duration for each past call.",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100,
      "angle": 0, "seed": 302, "version": 1, "versionNonce": 302,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null,
      "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "desc_uc4", "x": 490, "y": 332, "width": 360, "height": 40,
      "text": "Auto-install all required CLI tools. Verifies\ninstallation of claude, agy, copilot, opencode, kilo, cursor-agent.",
      "originalText": "Auto-install all required CLI tools. Verifies\ninstallation of claude, agy, copilot, opencode, kilo, cursor-agent.",
      "fontSize": 11, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent", "fillStyle": "solid",
      "strokeWidth": 1, "strokeStyle": "solid", "roughness": 0, "opacity": 100,
      "angle": 0, "seed": 303, "version": 1, "versionNonce": 303,
      "isDeleted": false, "groupIds": [], "boundElements": null, "link": null,
      "locked": false, "containerId": null, "lineHeight": 1.25 },
    { "type": "text", "id": "desc_uc5", "x": 490, "y": 407, "width": 360, "height": 40,
      "text": "Show all adapter health: circuit breaker state,\nfailure counts, last success for each adapter.",

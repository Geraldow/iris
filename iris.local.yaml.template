# iris local configuration — copy to iris.local.yaml and fill in your paths
# iris.local.yaml is gitignored — never commit it
#
# alesco_path: absolute path to your Alesco Google Drive folder
# iris derives: Source/odoo-enterprise-18, Source/odoo-community-18, Engram/
#
# Run `iris_setup` to auto-detect this value from your Google Drive installation.

alesco_path: # example: G:\My Drive\[1] YourName\[4] Work\Alesco

# db_schema: absolute path to db/schema.sql
# Solo necesario si el binario compilado no resuelve la ruta relativa.
# Usar forward slashes o doble backslash en Windows.
# db_schema: C:/Development/iris/db/schema.sql
